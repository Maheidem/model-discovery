{
  "id": "gemma4",
  "label": "Gemma 4",
  "sources": [
    "https://huggingface.co/google/gemma-4-31B-it/raw/main/chat_template.jinja",
    "https://unsloth.ai/docs/models/gemma-4",
    "https://huggingface.co/google/gemma-4-31B-it",
    "https://gemma.ai/get-started/capabilities/thinking/"
  ],
  "match": [
    "gemma[-_ ]?4(?!\\d)"
  ],
  "capabilities": {
    "image": true,
    "audio": false,
    "tools": true,
    "contextWindow": 131072
  },
  "variants": [
    {
      "match": [
        "(^|[^a-z0-9])e[24]b(?![a-z0-9])"
      ],
      "capabilities": {
        "audio": true
      }
    },
    {
      "match": [
        "(^|[^a-z0-9])(12|26|31)b(?![a-z0-9])"
      ],
      "capabilities": {
        "contextWindow": 262144
      }
    }
  ],
  "thinking": {
    "toggle": true,
    "efforts": [],
    "readsPreserve": true,
    "sendPreserve": false,
    "defaultOn": false
  },
  "sampling": {
    "off": {
      "temperature": 1,
      "topP": 0.95,
      "topK": 64
    },
    "on": {
      "temperature": 1,
      "topP": 0.95,
      "topK": 64
    }
  },
  "notes": {
    "thinking.sendPreserve": "The template reads preserve_thinking. Google guidance: drop old thinking. Thus the value is not sent."
  }
}
