{
  "id": "qwen3.5",
  "label": "Qwen 3.5 (4B and larger)",
  "sources": [
    "https://huggingface.co/Qwen/Qwen3.5-9B/raw/main/chat_template.jinja",
    "https://unsloth.ai/docs/models/qwen3.5.md"
  ],
  "match": [
    "qwen[-_ ]?3[._]5(?!\\d)"
  ],
  "capabilities": {
    "image": true,
    "audio": false,
    "tools": true,
    "contextWindow": 262144
  },
  "thinking": {
    "toggle": true,
    "efforts": [],
    "readsPreserve": false,
    "sendPreserve": false,
    "defaultOn": true
  },
  "sampling": {
    "off": {
      "temperature": 0.7,
      "topP": 0.8,
      "topK": 20,
      "presencePenalty": 1.5
    },
    "on": {
      "temperature": 0.6,
      "topP": 0.95,
      "topK": 20,
      "presencePenalty": 0
    }
  },
  "extraPresets": [
    {
      "slug": "thinking-general",
      "thinking": "on",
      "sampling": {
        "temperature": 1,
        "topP": 0.95,
        "topK": 20,
        "presencePenalty": 1.5
      }
    }
  ]
}
