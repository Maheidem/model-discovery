{
  "id": "inkling",
  "label": "Inkling",
  "sources": [
    "https://huggingface.co/thinkingmachines/Inkling/raw/main/chat_template.jinja",
    "https://unsloth.ai/docs/models/inkling",
    "https://huggingface.co/thinkingmachines/Inkling"
  ],
  "match": [
    "inkling(?![-_ ]?\\d)"
  ],
  "capabilities": {
    "image": false,
    "tools": true,
    "contextWindow": 131072
